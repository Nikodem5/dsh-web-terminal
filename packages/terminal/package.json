{
  "name": "@nikodem5/dsh-web-terminal",
  "version": "0.1.0",
  "private": false,
  "description": "Multi-terminal workspace inside the DeepSeek Harness web GUI: draggable PTY windows for running several coding agents side by side, with one-click Claude Code and Antigravity CLI launchers, attention states, usage stats, command blocks and SSH.",
  "author": "Nikodem Marcinkiewicz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikodem5/dsh-web-terminal.git",
    "directory": "packages/terminal"
  },
  "homepage": "https://github.com/Nikodem5/dsh-web-terminal#readme",
  "bugs": {
    "url": "https://github.com/Nikodem5/dsh-web-terminal/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "terminal",
    "pty",
    "web-terminal",
    "claude-code"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs && node smoke-host.mjs && node smoke-client.mjs && node smoke-view.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
