{
  "name": "dsh-code-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Monaco-based code editor and reviewer inside the DeepSeek Harness web GUI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/copy-shared-host.mjs && node build.mjs",
    "test": "node scripts/copy-shared-host.mjs && node --test tests/*.test.mjs && node smoke-view.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "marked": "^18.1.0",
    "monaco-editor": "^0.52.2",
    "ws": "^8.18.0"
  }
}
