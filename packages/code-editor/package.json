{
  "name": "dsh-code-editor",
  "version": "0.1.0",
  "private": false,
  "description": "Monaco-based code editor and reviewer inside the DeepSeek Harness web GUI: explorer, git tools, search in files and Markdown preview.",
  "author": "Nikodem Marcinkiewicz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikodem5/dsh-web-terminal.git",
    "directory": "packages/code-editor"
  },
  "homepage": "https://github.com/Nikodem5/dsh-web-terminal#readme",
  "bugs": {
    "url": "https://github.com/Nikodem5/dsh-web-terminal/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "code-editor",
    "monaco",
    "git"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/copy-shared-host.mjs && node build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/copy-shared-host.mjs && node --test tests/*.test.mjs && node smoke-view.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "marked": "^18.1.0",
    "monaco-editor": "^0.52.2"
  }
}
