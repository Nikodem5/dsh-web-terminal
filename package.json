{
  "name": "dsh-web-terminal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugins: web terminal, code editor (coming next), shared helpers.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "install:desktop": "node scripts/install.mjs desktop",
    "install:web": "node scripts/install.mjs web",
    "install:all": "node scripts/install.mjs",
    "install:dry": "node scripts/install.mjs --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
